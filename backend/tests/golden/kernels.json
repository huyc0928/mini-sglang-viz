/radix.cpp","line":12,"base":"","signature":"auto _is_1d_cpu_int_tensor(const tvm::ffi::TensorView tensor) -> bool {","ext":".cpp"},{"name":"fast_compare_key","kind":"function","file":"python/minisgl/kernel/csrc/src/radix.cpp","line":19,"base":"","signature":"auto fast_compare_key(const tvm::ffi::TensorView a,","ext":".cpp"},{"name":"test","kind":"function","file":"python/minisgl/kernel/csrc/src/tensor.cpp","line":14,"base":"","signature":"auto test(tvm::ffi::TensorView x, tvm::ffi::TensorView y) -> void {","ext":".cpp"}],"triton":[{"name":"moe_sum_reduce_kernel","kind":"triton_kernel","file":"python/minisgl/kernel/triton/fused_moe.py","line":6,"end_line":47,"signature":"moe_sum_reduce_kernel(input_ptr, input_stride_0, input_stride_1, input_stride_2, output_ptr, output_stride_0, output_stride_1, token_num: int, topk_num: int, hidden_dim: int, BLOCK_M: tl.constexpr, BLOCK_DIM: tl.constexpr, NUM_STAGE: tl.constexpr)","decorators":["triton.jit"],"docstring":"","params":[{"name":"input_ptr","annotation":""},{"name":"input_stride_0","annotation":""},{"name":"input_stride_1","annotation":""},{"name":"input_stride_2","annotation":""},{"name":"output_ptr","annotation":""},{"name":"output_stride_0","annotation":""},{"name":"output_stride_1","annotation":""},{"name":"token_num","annotation":"int"},{"name":"topk_num","annotation":"int"},{"name":"hidden_dim","annotation":"int"},{"name":"BLOCK_M","annotation":"tl.constexpr"},{"name":"BLOCK_DIM","annotation":"tl.constexpr"},{"name":"NUM_STAGE","annotation":"tl.constexpr"}]},{"name":"fused_moe_kernel","kind":"triton_kernel","file":"python/minisgl/kernel/triton/fused_moe.py","line":51,"end_line":193,"signature":"fused_moe_kernel(a_ptr, b_ptr, c_ptr, topk_weights_ptr, sorted_token_ids_ptr, expert_ids_ptr, num_tokens_post_padded_ptr, N, K, EM, num_valid_tokens, stride_am, stride_ak, stride_be, stride_bk, stride_bn, stride_cm, stride_cn, BLOCK_SIZE_M: tl.constexpr, BLOCK_SIZE_N: tl.constexpr, BLOCK_SIZE_K: tl.constexpr, GROUP_SIZE_M: tl.constexpr, MUL_ROUTED_WEIGHT: tl.constexpr, top_k: tl.constexpr, compute_type: tl.constexpr, even_Ks: tl.constexpr)","decorators":["triton.jit"],"docstring":"Implements the fused computation for a Mixture of Experts (MOE) using\ntoken and expert matrices.\n\nKey Parameters:\n- A: The input tensor representing tokens with shape (*, K), where '*' can\n    be any shape representing batches and K is the feature dimension of\n    each token.\n- B: The stacked MOE weight tensor with shape (E, N, K), where E is\n    the number of experts, K is the input feature dimension, and N is\n    the output feature dimension.\n- C: The output cache tensor with shape (M, topk, N), where M is the\n    total number of tokens post padding, topk is the number of times\n    each token is repeated, and N is the output feature dimension.\n- sorted_token_ids: A tensor containing the sorted indices of tokens,\n    repeated topk times and arranged by the expert index they are\n    assigned to.\n- expert_ids: A tensor containing the indices of the expert for each\n    block. It determines which expert matrix from B should be used for\n    each block in A.\n\nThis kernel performs the multiplication of a token by its corresponding\nexpert matrix as determined by `expert_ids`. The sorting of\n`sorted_token_ids` by expert index and padding ensures divisibility by\nBLOCK_SIZE_M, which is necessary to maintain consistency in block matrix\nmultiplication across different blocks processed by the same expert.","params":[{"name":"a_ptr","annotation":""},{"name":"b_ptr","annotation":""},{"name":"c_ptr","annotation":""},{"name":"topk_weights_ptr","annotation":""},{"name":"sorted_token_ids_ptr","annotation":""},{"name":"expert_ids_ptr","annotation":""},{"name":"num_tokens_post_padded_ptr","annotation":""},{"name":"N","annotation":""},{"name":"K","annotation":""},{"name":"EM","annotation":""},{"name":"num_valid_tokens","annotation":""},{"name":"stride_am","annotation":""},{"name":"stride_ak","annotation":""},{"name":"stride_be","annotation":""},{"name":"stride_bk","annotation":""},{"name":"stride_bn","annotation":""},{"name":"stride_cm","annotation":""},{"name":"stride_cn","annotation":""},{"name":"BLOCK_SIZE_M","annotation":"tl.constexpr"},{"name":"BLOCK_SIZE_N","annotation":"tl.constexpr"},{"name":"BLOCK_SIZE_K","annotation":"tl.constexpr"},{"name":"GROUP_SIZE_M","annotation":"tl.constexpr"},{"name":"MUL_ROUTED_WEIGHT","annotation":"tl.constexpr"},{"name":"top_k","annotation":"tl.constexpr"},{"name":"compute_type","annotation":"tl.constexpr"},{"name":"even_Ks","annotation":"tl.constexpr"}]}]}