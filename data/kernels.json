  each block in A.\n\nThis kernel performs the multiplication of a token by its corresponding\nexpert matrix as determined by `expert_ids`. The sorting of\n`sorted_token_ids` by expert index and padding ensures divisibility by\nBLOCK_SIZE_M, which is necessary to maintain consistency in block matrix\nmultiplication across different blocks processed by the same expert.","end_line":193,"ext":".py","file":"python/minisgl/kernel/triton/fused_moe.py","kind":"triton_kernel","line":51,"name":"fused_moe_kernel","params":[{"annotation":"","default":"","kind":"pos","name":"a_ptr"},{"annotation":"","default":"","kind":"pos","name":"b_ptr"},{"annotation":"","default":"","kind":"pos","name":"c_ptr"},{"annotation":"","default":"","kind":"pos","name":"topk_weights_ptr"},{"annotation":"","default":"","kind":"pos","name":"sorted_token_ids_ptr"},{"annotation":"","default":"","kind":"pos","name":"expert_ids_ptr"},{"annotation":"","default":"","kind":"pos","name":"num_tokens_post_padded_ptr"},{"annotation":"","default":"","kind":"pos","name":"N"},{"annotation":"","default":"","kind":"pos","name":"K"},{"annotation":"","default":"","kind":"pos","name":"EM"},{"annotation":"","default":"","kind":"pos","name":"num_valid_tokens"},{"annotation":"","default":"","kind":"pos","name":"stride_am"},{"annotation":"","default":"","kind":"pos","name":"stride_ak"},{"annotation":"","default":"","kind":"pos","name":"stride_be"},{"annotation":"","default":"","kind":"pos","name":"stride_bk"},{"annotation":"","default":"","kind":"pos","name":"stride_bn"},{"annotation":"","default":"","kind":"pos","name":"stride_cm"},{"annotation":"","default":"","kind":"pos","name":"stride_cn"},{"annotation":"tl.constexpr","default":"","kind":"pos","name":"BLOCK_SIZE_M"},{"annotation":"tl.constexpr","default":"","kind":"pos","name":"BLOCK_SIZE_N"},{"annotation":"tl.constexpr","default":"","kind":"pos","name":"BLOCK_SIZE_K"},{"annotation":"tl.constexpr","default":"","kind":"pos","name":"GROUP_SIZE_M"},{"annotation":"tl.constexpr","default":"","kind":"pos","name":"MUL_ROUTED_WEIGHT"},{"annotation":"tl.constexpr","default":"","kind":"pos","name":"top_k"},{"annotation":"tl.constexpr","default":"","kind":"pos","name":"compute_type"},{"annotation":"tl.constexpr","default":"","kind":"pos","name":"even_Ks"}],"signature":"fused_moe_kernel(a_ptr, b_ptr, c_ptr, topk_weights_ptr, sorted_token_ids_ptr, expert_ids_ptr, num_tokens_post_padded_ptr, N, K, EM, num_valid_tokens, stride_am, stride_ak, stride_be, stride_bk, stride_bn, stride_cm, stride_cn, BLOCK_SIZE_M: tl.constexpr, BLOCK_SIZE_N: tl.constexpr, BLOCK_SIZE_K: tl.constexpr, GROUP_SIZE_M: tl.constexpr, MUL_ROUTED_WEIGHT: tl.constexpr, top_k: tl.constexpr, compute_type: tl.constexpr, even_Ks: tl.constexpr)"}]}